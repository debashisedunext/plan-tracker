#!/usr/bin/env bash
# plan — project scheduling from a markdown backlog.
#
#   plan init            scaffold plan.config.json and the plan directory
#   plan refresh         re-derive status from git, reschedule, rebuild outputs
#   plan brief           post today's briefs to GitHub issues
#   plan daily           refresh + commit + push + brief   (what the 09:00 job runs)
#   plan cron install    run `plan daily` at 09:00, Monday to Friday
#   plan cron status     is it scheduled, when did it last run
#   plan cron remove     stop it
#   plan check           prove the chart actually renders
#   plan config          show what this project is configured as
#
# Every command works from anywhere inside the project — the config is found by
# walking up from the current directory.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE="$HERE/engine"
PY="${PLAN_PYTHON:-python3}"

die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
note() { printf '\033[2m%s\033[0m\n' "$*"; }

find_root() {
  [[ -n "${PLAN_CONFIG:-}" ]] && { dirname "$PLAN_CONFIG"; return; }
  local d; d="$(pwd)"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/plan.config.json" ]] && { echo "$d"; return; }
    d="$(dirname "$d")"
  done
  die "No plan.config.json here or above. Run 'plan init' in the project root."
}

label_for() {  # a launchd label unique to this project path
  echo "com.plantracker.$(find_root | shasum | cut -c1-10)"
}

cmd_init() {
  [[ -f plan.config.json ]] && die "plan.config.json already exists here."
  local name; name="$(basename "$(pwd)")"
  local dir="${1:-docs/plan}"
  sed "s|__PROJECT__|$name|g; s|__PLANDIR__|$dir|g; s|__START__|$(date +%F)|g" \
    "$HERE/templates/plan.config.json" > plan.config.json
  mkdir -p "$dir/standup"
  [[ -f "$dir/calendar.json" ]] || sed "s|__START__|$(date +%F)|g" \
    "$HERE/templates/calendar.json" > "$dir/calendar.json"
  cp -n "$HERE/templates/overrides.json" "$dir/overrides.json" 2>/dev/null || true
  cp -n "$HERE/templates/plan-README.md" "$dir/README.md" 2>/dev/null || true
  cp -n "$HERE/templates/seed.txt"       "$dir/seed.txt" 2>/dev/null || true
  cat <<EOF

Created plan.config.json and $dir/

Next, in this order:

  1. Edit plan.config.json — your streams, owners, GitHub handles, repo.
  2. Write a backlog. One markdown file per stream, tasks as:
         - [ ] **A-001** What has to be done
     Or ask Claude to draft it:  /plan-init
  3. plan refresh
  4. plan cron install

EOF
}

cmd_refresh() {
  cd "$(find_root)"
  "$PY" "$ENGINE/extract.py"
  "$PY" "$ENGINE/schedule.py" "$@"
}

cmd_brief()  { cd "$(find_root)"; "$PY" "$ENGINE/notify.py" "$@"; }
cmd_config() { cd "$(find_root)"; "$PY" "$ENGINE/planconfig.py"; }

cmd_check() {
  cd "$(find_root)"
  local plandir; plandir="$("$PY" -c "
import sys,os; sys.path.insert(0,'$ENGINE'); import planconfig
c=planconfig.load(); print(os.path.relpath(c.plan_dir, c.root))")"
  command -v node >/dev/null || die "node is needed for 'plan check' (chart render test)."
  node "$ENGINE/test/render_check.js" "$plandir/gantt.html"
}

cmd_daily() {
  local root; root="$(find_root)"; cd "$root"
  local today dow
  today="$(date +%F)"; dow="$(date +%u)"
  [[ "$dow" -ge 6 ]] && { note "$today is a weekend — the plan only moves on working days."; exit 0; }

  echo "── plan refresh · $today ──────────────────────────────────────────"
  if git rev-parse --git-dir >/dev/null 2>&1; then
    git fetch --all --prune --quiet || true
    if [[ -z "$(git status --porcelain)" ]] && git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      git merge --ff-only '@{u}' --quiet 2>/dev/null || note "  (not fast-forwardable — using local state)"
    else
      note "  (working tree dirty or no upstream — not pulling)"
    fi
  fi

  cmd_refresh

  if git rev-parse --git-dir >/dev/null 2>&1; then
    local plandir; plandir="$("$PY" -c "
import sys,os; sys.path.insert(0,'$ENGINE'); import planconfig
c=planconfig.load(); print(os.path.relpath(c.plan_dir, c.root))")"
    # Commit ONLY the generated plan files, by path. A scheduled job must never
    # sweep up whatever somebody left staged and label it a plan refresh —
    # `git add` + bare `git commit` does exactly that, and it happened once.
    local files=("$plandir/GANTT.md" "$plandir/gantt.html" "$plandir/tasks.csv"
                 "$plandir/standup/$today.md")
    local present=(); for f in "${files[@]}"; do [[ -f "$f" ]] && present+=("$f"); done
    if [[ ${#present[@]} -gt 0 ]] && ! git diff --quiet -- "${present[@]}" 2>/dev/null \
       || git ls-files --others --exclude-standard -- "${present[@]}" | grep -q .; then
      git commit -q -m "chore(plan): daily schedule refresh $today" \
                    -m "Regenerated by plan-tracker. Status derived from git." \
                    -- "${present[@]}"
      git push --quiet origin HEAD 2>/dev/null && note "  pushed" || note "  (push failed — plan is committed locally)"
    else
      note "  plan unchanged — nothing to commit"
    fi
  fi

  if [[ "${PLAN_NOTIFY:-1}" == "1" ]]; then
    cmd_brief --date "$today" || note "  (briefs not posted)"
  else
    note "  notifications suppressed (PLAN_NOTIFY=0)"
  fi
  echo "── done ───────────────────────────────────────────────────────────"
}

cmd_cron() {
  local root; root="$(find_root)"
  local label; label="$(label_for)"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  local log="$HOME/Library/Logs/plan-$(basename "$root").log"

  case "${1:-status}" in
  install)
    [[ "$(uname)" == "Darwin" ]] || die "'plan cron install' is macOS-only. On Linux use:
  0 9 * * 1-5  cd $root && $HERE/plan daily >> $log 2>&1"
    local hour="${2:-9}" minute="${3:-0}"
    { echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
      echo '<plist version="1.0"><dict>'
      echo "  <key>Label</key><string>$label</string>"
      echo '  <key>ProgramArguments</key>'
      echo "  <array><string>/bin/bash</string><string>-lc</string><string>$HERE/plan daily</string></array>"
      echo "  <key>WorkingDirectory</key><string>$root</string>"
      echo '  <key>StartCalendarInterval</key><array>'
      for d in 1 2 3 4 5; do
        echo "    <dict><key>Weekday</key><integer>$d</integer><key>Hour</key><integer>$hour</integer><key>Minute</key><integer>$minute</integer></dict>"
      done
      echo '  </array>'
      echo '  <key>EnvironmentVariables</key><dict>'
      echo '    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>'
      echo '    <key>PLAN_NOTIFY</key><string>1</string></dict>'
      echo "  <key>StandardOutPath</key><string>$log</string>"
      echo "  <key>StandardErrorPath</key><string>$log</string>"
      echo '  <key>RunAtLoad</key><false/><key>ProcessType</key><string>Background</string>'
      echo '</dict></plist>'
    } > "$plist"
    plutil -lint "$plist" >/dev/null || die "generated plist is invalid: $plist"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "Scheduled: $(basename "$root") at $(printf '%02d:%02d' "$hour" "$minute"), Monday to Friday."
    echo "  log     $log"
    echo "  remove  plan cron remove"
    ;;
  remove)
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    rm -f "$plist"; echo "Unscheduled $(basename "$root")." ;;
  status)
    if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
      echo "Scheduled — $label"
      launchctl print "gui/$(id -u)/$label" | grep -E '^\s+(state|runs|last exit code)' || true
      [[ -f "$log" ]] && { echo; echo "Last run:"; tail -n 12 "$log"; }
    else
      echo "Not scheduled. Run: plan cron install"
    fi ;;
  *) die "plan cron [install|remove|status]" ;;
  esac
}

case "${1:-}" in
  init)    shift; cmd_init "$@" ;;
  refresh) shift; cmd_refresh "$@" ;;
  brief)   shift; cmd_brief "$@" ;;
  daily)   shift; cmd_daily "$@" ;;
  cron)    shift; cmd_cron "$@" ;;
  check)   shift; cmd_check "$@" ;;
  config)  shift; cmd_config "$@" ;;
  ""|-h|--help|help) sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) die "Unknown command: $1   (try: plan help)" ;;
esac
